# PostgreSQL connection string (Render / Railway / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/quizarena?schema=public"

# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGINS="http://localhost:5173,https://your-app.vercel.app"

# Public URL of the frontend, used for the QR code join link
CLIENT_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Max players per game
MAX_PLAYERS=200

# Optional: set when running more than one backend instance (enables Socket.IO Redis adapter)
REDIS_URL=

# Where uploaded question images are stored (use a persistent disk in production)
UPLOAD_DIR=./uploads
